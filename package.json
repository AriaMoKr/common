{
  "name": "common",
  "version": "0.8.2",
  "description": "Code shared by the sites behind the Hallway's doors: the door contract (a door's link, the way back, the view from it), walking controls, VR and accessibility settings, a three.js doorway, fade, gamepad, sky and panels, a book's text view and browser Back, the TV's remote, and their dev server, vendor copy, Chrome launcher and Pages workflow.",
  "keywords": ["webxr", "threejs", "hallway", "portal", "deep-link", "controls", "gamepad", "sky", "panel", "text-view", "accessibility", "history", "tv", "devtools", "github-pages"],
  "homepage": "https://github.com/AriaMoKr/common#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/common.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/common/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./access.js": "./src/access.js",
    "./back-history.js": "./src/back-history.js",
    "./controls.js": "./src/controls.js",
    "./door.js": "./src/door.js",
    "./fade.js": "./src/fade.js",
    "./gamepad.js": "./src/gamepad.js",
    "./nav.js": "./src/nav.js",
    "./panel.js": "./src/panel.js",
    "./portal.js": "./src/portal.js",
    "./sky.js": "./src/sky.js",
    "./text-view.js": "./src/text-view.js",
    "./tv.js": "./src/tv.js",
    "./tools/chrome.mjs": "./tools/chrome.mjs",
    "./tools/serve.mjs": "./tools/serve.mjs",
    "./tools/vendor.mjs": "./tools/vendor.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "tools/"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "types": "node -e \"for (const d of ['src', 'tools']) for (const f of require('fs').readdirSync(d)) if (f.endsWith('.d.ts') || f.endsWith('.d.mts')) require('fs').rmSync(d + '/' + f)\" && tsc -p tsconfig.json && tsc -p tsconfig.tools.json"
  },
  "peerDependencies": {
    "three": ">=0.154.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "three": "0.186.1",
    "typescript": "5.9.3"
  }
}
